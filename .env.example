APP_NAME="CEAN — Control Escolar y Administración Normalista"

# Identidad (opcional; valores por defecto en config/cean.php)
# CEAN_ACRONYM=CEAN
# CEAN_FULL_NAME="Control Escolar y Administración Normalista"
# CEAN_INSTITUTION="Escuela Normal Superior de Querétaro"

APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debe coincidir con el puerto de `php artisan serve --port=8001`
APP_URL=http://127.0.0.1:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Para hosting compartido (MySQL), descomenta y configura:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cean_control_escolar
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
# En hosting compartido puedes usar: SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# En hosting compartido usa sync (sin workers en segundo plano)

CACHE_STORE=database
# En hosting compartido puedes usar: CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Google Workspace ENSQ)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAIN=ensq.edu.mx
CEAN_INSTITUTIONAL_DOMAIN=ensq.edu.mx

BOLETA_ESCUELA="ESCUELA NORMAL SUPERIOR DE QUERÉTARO"
BOLETA_DIRECTOR="MTRO. ROBERTO COMPEÁN MARTÍNEZ"
BOLETA_CIUDAD="SANTIAGO DE QUERÉTARO, QRO."
BOLETA_LICENCIATURA="LICENCIATURA EN ENSEÑANZA Y APRENDIZAJE EN"
BOLETA_CODIGO="FM.ENCE.14"
BOLETA_VERSION="00"
BOLETA_BANNER_GOBIERNO=images/boleta/gob-educacion.png
BOLETA_LOGO_ENSQ=images/boleta/logo-ensq.png

# Ruta al Excel de reinscripción 25-26B (opcional; usado por AlumnosFicha2526BSeeder si falta el JSON)
# REINSCRIPCION_2526B_EXCEL="/Users/tu-usuario/Downloads/Reinscripción 25-26B (Respuestas).xlsx"
